# Copy to a private .env. Paths may be absolute or relative to this file.
# Never commit the real .env, a Hub database or a credential vault.
SIDECAR_DATA_DIR=./var
SIDECAR_BIND=127.0.0.1
SIDECAR_PORT=20600
SIDECAR_PUBLIC_URL=https://sidecar.example.com
SIDECAR_COOKIE_NAME=qwenpaw_sidecar_session

# This directory is the Hub's hub/ directory, containing control.db, runtimes/, secrets/.
# QwenPaw Hub and managed Docker runtimes must already be deployed on this Linux host.
HUB_DATA_DIR=/srv/qwenpaw-data/hub
HUB_URL=http://127.0.0.1:8088
HUB_PUBLIC_URL=https://hub.example.com
# Exact browser Origins; comma-separated; no wildcard.
HUB_ORIGINS=https://hub.example.com

# An EXISTING enabled Hub username. This does not create a Hub account or change its role.
ADMIN_USERNAME=owner
# Optional stable Hub user_id takes precedence over the username.
ADMIN_USER_ID=

# Must be reachable from every managed runtime container.
# For host-only HTTP trials use the real Docker bridge gateway and port, not container localhost.
MCP_PUBLIC_URL=https://sidecar.example.com/mcp
# Public host from URLs is added automatically. Add internal Host/Origin values only as needed.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# RAGFlow API address (not necessarily its frontend address).
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
CREDENTIAL_DAYS=90
